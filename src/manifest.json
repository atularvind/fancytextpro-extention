{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "FancyTextPro",
  "description": "__MSG_extDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "homepage_url": "https://www.fancytextpro.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {},
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F" },
      "description": "__MSG_cmdOpenPopup__"
    },
    "apply-last-style": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "MacCtrl+Shift+L" },
      "description": "__MSG_cmdApplyLast__"
    }
  }
}
